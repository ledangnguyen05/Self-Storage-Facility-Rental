# ==============================================================================
# BOXORA BACKEND - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép file này và đổi tên thành .env trong thư mục BE/boxora/
#    Ví dụ lệnh: cp .env.example .env (Linux/macOS) hoặc copy .env.example .env (Windows)
# 2. Điền các giá trị thực tế phù hợp với môi trường máy của bạn vào file .env
# 3. File .env chứa thông tin nhạy cảm (mật khẩu DB, Mail, JWT Secret, API Key)
#    và ĐÃ ĐƯỢC CHẶN trong .gitignore để không bao giờ bị push lên Git repo.
# ==============================================================================

# ==========================================
# 1. DATABASE (PostgreSQL)
# ==========================================
# URL kết nối cơ sở dữ liệu PostgreSQL. Mặc định port 5432, database tên boxora_db.
# Lưu ý: Hãy tạo sẵn database 'boxora_db' trong PostgreSQL trước khi chạy ứng dụng.
DB_URL=jdbc:postgresql://localhost:5432/boxora_db
DB_USERNAME=postgres
DB_PASSWORD=postgres


# ==========================================
# 2. JPA / HIBERNATE
# ==========================================
# JPA_DDL_AUTO:
#   - update: Tự động cập nhật bảng theo Entity (thích hợp môi trường Development)
#   - validate: Chỉ kiểm tra schema với Entity (khuyên dùng khi chạy Production cùng Flyway)
#   - create / create-drop: Xóa và tạo lại toàn bộ schema (chỉ dùng test)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true


# ==========================================
# 3. MAIL (Gmail SMTP - Gửi OTP, xác nhận tài khoản)
# ==========================================
# Cổng và host SMTP của Gmail:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Tài khoản Gmail dùng để gửi email từ hệ thống:
MAIL_USERNAME=your_email@gmail.com

# HƯỚNG DẪN LẤY MAIL_PASSWORD (Mật khẩu ứng dụng - App Password):
# - Đây KHÔNG PHẢI là mật khẩu đăng nhập tài khoản Gmail cá nhân.
# - Bước 1: Truy cập https://myaccount.google.com/security
# - Bước 2: Bật "Xác minh 2 bước" (2-Step Verification) cho tài khoản Google của bạn.
# - Bước 3: Tìm mục "Mật khẩu ứng dụng" (App Passwords) hoặc truy cập https://myaccount.google.com/apppasswords
# - Bước 4: Tạo một tên mới (ví dụ: Boxora) -> Google sẽ cấp chuỗi 16 ký tự (ví dụ: abcd efgh ijkl mnop).
# - Bước 5: Dán chuỗi 16 ký tự đó vào đây.
MAIL_PASSWORD=your_app_password

MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true


# ==========================================
# 4. JWT (JSON Web Token Authentication)
# ==========================================
# Khóa bí mật dùng cho thuật toán ký HMAC-SHA256 (bắt buộc độ dài tối thiểu 256 bits = 64 ký tự Hex).
# Bạn có thể sinh chuỗi mới bằng lệnh: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Thời gian hết hạn Access Token (tính bằng mili-giây):
# Mặc định: 900000 ms = 15 phút
JWT_ACCESS_TOKEN_EXPIRATION=900000

# Thời gian hết hạn Refresh Token (tính bằng mili-giây):
# Mặc định: 604800000 ms = 7 ngày
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ==========================================
# 5. ASYNC THREAD POOL
# ==========================================
# Số lượng thread trong pool xử lý tác vụ bất đồng bộ (@Async):
ASYNC_CORE_SIZE=5
ASYNC_MAX_SIZE=10


# ==========================================
# 6. SERVER & FRONTEND CORS
# ==========================================
# Port backend Spring Boot:
SERVER_PORT=8080

# URL Frontend kết nối tới (dùng để cấu hình CORS cho phép giao tiếp):
APP_FRONTEND_URL=http://localhost:5173


# ==========================================
# 7. SWAGGER / OPENAPI DOCUMENTATION
# ==========================================
# Đường dẫn truy cập tài liệu API:
# Sau khi khởi động, vào: http://localhost:8080/swagger-ui.html
SWAGGER_API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html


# ==========================================
# 8. LOGGING
# ==========================================
# Mức độ log: TRACE, DEBUG, INFO, WARN, ERROR
LOGGING_APP_LEVEL=DEBUG
LOGGING_SECURITY_LEVEL=INFO


# ==========================================
# 9. SEED USERS (Mật khẩu tài khoản mẫu khi khởi tạo)
# ==========================================
# Mật khẩu mặc định được seed vào DB cho các vai trò khi hệ thống chạy lần đầu:
SEED_ADMIN_PASSWORD=admin
SEED_FACILITY_MANAGER_PASSWORD=facility
SEED_BUSINESS_MANAGER_PASSWORD=business
SEED_STAFF_PASSWORD=staff
SEED_CUSTOMER_PASSWORD=customer


# ==========================================
# 10. VNPAY SANDBOX (Cổng thanh toán thử nghiệm)
# ==========================================
# Cổng thông tin Merchant Sandbox: https://sandbox.vnpayment.vn/
# Đăng ký tài khoản Sandbox để nhận vnp_TmnCode và vnp_HashSecret.
# Hoặc sử dụng cấu hình sandbox mẫu bên dưới nếu nhóm dự án đã có:
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return

# Các tham số mặc định của giao thức VNPay 2.1.0:
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other

# THÔNG TIN THẺ TEST THỬ NGHIỆM TRÊN CỔNG VNPAY SANDBOX (Ngân hàng NCB):
# - Số thẻ: 9704198526191432198
# - Tên chủ thẻ: NGUYEN VAN A
# - Ngày phát hành: 07/15
# - OTP xác thực: 123456


# ==========================================
# 11. DOCUSEAL (Hợp đồng điện tử & Ký số trực tuyến)
# ==========================================
# DocuSeal được sử dụng để tạo và quản lý mẫu hợp đồng thuê kho / ký kết điện tử:
# Bạn có thể tự host qua Docker: docker run -p 3000:3000 docuseal/docuseal
# Hoặc sử dụng dịch vụ đám mây tại https://www.docuseal.com/
DOCUSEAL_API_URL=http://localhost:3000/api
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=1
DOCUSEAL_RENEWAL_TEMPLATE_ID=
DOCUSEAL_WEBHOOK_TOKEN=


# ==========================================
# 12. REDIS (Distributed Lock 24h & Caching)
# ==========================================
# Dùng để phân tán soft-lock khi khách hàng giữ chỗ kho trong 24 giờ và tăng tốc cache.
# Chạy Redis local hoặc Docker: docker run -p 6379:6379 redis:alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true


# ==========================================
# 13. SCHEDULING & CRON JOBS (Tác vụ định kỳ)
# ==========================================
# Bật/tắt hệ thống chạy các job nền:
SCHEDULING_ENABLED=true

# Biểu thức Cron kiểm tra các đơn thuê bị quá hạn:
# Mặc định: 0 0 1 * * ? (Chạy vào 01:00 AM mỗi ngày)
SCHEDULING_OVERDUE_CRON=0 0 1 * * ?

# Biểu thức Cron kiểm tra và tự động hủy đơn giữ chỗ chưa thanh toán:
# Mặc định: 0 */15 * * * ? (Chạy mỗi 15 phút một lần)
AUTO_CANCEL_CRON=0 */15 * * * ?

# Thời gian tối đa (phút) giữ đơn PENDING chờ thanh toán trước khi bị hủy tự động:
PENDING_TIMEOUT_MINUTES=15


# ==========================================
# 14. BOOKING RULES & SOFT-LOCK
# ==========================================
# Số giờ giữ chỗ tạm thời (soft-lock) kho cho khách hàng:
BOOKING_SOFT_LOCK_HOURS=24

# Số ngày tối đa được phép đặt trước ngày bắt đầu thuê kho:
BOOKING_MAX_ADVANCE_DAYS=30


# ==========================================
# 15. FILE UPLOAD & STORAGE
# ==========================================
# Thư mục lưu trữ file và hình ảnh tải lên máy chủ:
UPLOAD_DIR=uploads
