# ==============================================================================
# BOXORA BACKEND - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# Hệ thống quản lý & cho thuê kho tự quản thông minh Boxora (Self-Storage)
# ==============================================================================
# HƯỚNG DẪN BẮT ĐẦU NHANH (QUICK START):
# 1. Tạo file .env từ template này trong thư mục BE/boxora/:
#      - Windows (PowerShell): Copy-Item .env.example .env
#      - Windows (CMD):        copy .env.example .env
#      - Linux / macOS:        cp .env.example .env
# 2. Tạo database PostgreSQL có tên 'boxora_db' trước khi khởi chạy:
#      - Lệnh SQL: CREATE DATABASE boxora_db;
# 3. Điền thông tin thực tế của bạn (hoặc giữ các giá trị mặc định cho môi trường dev).
# 4. CHÚ Ý BẢO MẬT: File .env chứa thông tin bí mật (mật khẩu DB, JWT Secret, 
#    Mail App Password, API Key VNPay / DocuSeal / Google Gemini).
#    File này ĐÃ ĐƯỢC CHẶN trong .gitignore - TUYỆT ĐỐI KHÔNG commit .env lên Git.
# ==============================================================================


# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# URL kết nối cơ sở dữ liệu PostgreSQL. Mặc định port 5432, database tên boxora_db.
# Chuỗi kết nối mẫu: jdbc:postgresql://<host>:<port>/<database_name>?characterEncoding=UTF-8
DB_URL=jdbc:postgresql://localhost:5432/boxora_db?characterEncoding=UTF-8

# Tài khoản quản trị database PostgreSQL (mặc định thường là postgres):
DB_USERNAME=postgres

# Mật khẩu kết nối database PostgreSQL của bạn:
DB_PASSWORD=postgres


# ==============================================================================
# 2. JPA & HIBERNATE (ORM & Schema Management)
# ==============================================================================
# Cơ chế tự động quản lý cấu trúc bảng (DDL):
#   - update:      Tự động thêm/sửa cột & bảng theo Entity (khuyên dùng khi Dev)
#   - validate:    Chỉ kiểm tra tính khớp giữa Entity và Database (khuyên dùng Production)
#   - create-drop: Xóa sạch và tạo lại toàn bộ bảng mỗi lần restart (chỉ dùng test nội bộ)
JPA_DDL_AUTO=update

# Hiển thị câu lệnh SQL thực thi trong log console:
JPA_SHOW_SQL=false

# Định dạng format thụt dòng câu lệnh SQL cho dễ đọc:
JPA_FORMAT_SQL=false


# ==============================================================================
# 3. MAIL SERVICE (Gmail SMTP - Gửi mã OTP, Xác thực email & Thông báo)
# ==============================================================================
# Máy chủ SMTP của Google:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Địa chỉ Gmail hệ thống dùng để gửi email cho khách hàng:
MAIL_USERNAME=your_system_email@gmail.com

# ------------------------------------------------------------------------------
# HƯỚNG DẪN TẠO "MẬT KHẨU ỨNG DỤNG" (APP PASSWORD) CHO GMAIL:
# Chú ý: Đây KHÔNG PHẢI là mật khẩu đăng nhập email thông thường!
#   - Bước 1: Truy cập trang quản lý tài khoản Google: https://myaccount.google.com/security
#   - Bước 2: Bật "Xác minh 2 bước" (2-Step Verification) nếu chưa bật.
#   - Bước 3: Tìm mục "Mật khẩu ứng dụng" (App passwords)
#             hoặc truy cập trực tiếp: https://myaccount.google.com/apppasswords
#   - Bước 4: Đặt tên cho ứng dụng (ví dụ: Boxora Server) rồi nhấn "Tạo" (Create).
#   - Bước 5: Google sẽ cấp chuỗi mật mã 16 ký tự (ví dụ: abcd efgh ijkl mnop).
#   - Bước 6: Dán chuỗi 16 ký tự đó vào MAIL_PASSWORD bên dưới (có thể giữ hoặc bỏ khoảng trắng).
# ------------------------------------------------------------------------------
MAIL_PASSWORD=your_16_char_app_password

# Cấu hình bảo mật giao thức gửi mail TLS:
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true


# ==============================================================================
# 4. JWT AUTHENTICATION (JSON Web Token Security)
# ==============================================================================
# Khóa bí mật dùng cho thuật toán ký HMAC-SHA256 (bắt buộc độ dài tối thiểu 256 bits = 64 ký tự Hex).
# Bạn có thể tự sinh chuỗi khóa ngẫu nhiên mới bằng lệnh Terminal:
#   openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Thời gian hết hạn Access Token (tính bằng mili-giây ms):
# Mặc định: 86400000 ms = 24 giờ (tiện lợi khi phát triển), Production khuyến nghị 900000 ms (15 phút)
JWT_ACCESS_TOKEN_EXPIRATION=86400000

# Thời gian hết hạn Refresh Token (tính bằng mili-giây ms):
# Mặc định: 604800000 ms = 7 ngày
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ==============================================================================
# 5. ASYNC THREAD POOL (Xử lý tác vụ nền bất đồng bộ)
# ==============================================================================
# Số lượng luồng xử lý nền tối thiểu và tối đa (@Async gửi mail, ghi audit log, quét cron):
ASYNC_CORE_SIZE=5
ASYNC_MAX_SIZE=10


# ==============================================================================
# 6. SERVER & CORS CONFIGURATION
# ==============================================================================
# Cổng chạy ứng dụng Backend Spring Boot (mặc định 8080):
SERVER_PORT=8080

# URL ứng dụng Frontend được phép truy cập API qua cơ chế CORS:
# Phổ biến: https://boxora-web.vercel.app hoặc http://localhost:5173 (Vite Dev Server)
APP_FRONTEND_URL=https://boxora-web.vercel.app


# ==============================================================================
# 7. SWAGGER / OPENAPI DOCUMENTATION
# ==============================================================================
# Đường dẫn tài liệu đặc tả API và giao diện UI kiểm thử:
# Sau khi khởi động backend, truy cập: http://localhost:8080/swagger-ui.html
SWAGGER_API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html


# ==============================================================================
# 8. LOGGING LEVELS
# ==============================================================================
# Mức độ chi tiết log: TRACE, DEBUG, INFO, WARN, ERROR
LOGGING_APP_LEVEL=DEBUG
LOGGING_SECURITY_LEVEL=INFO


# ==============================================================================
# 9. SEED DEFAULT USERS (Mật khẩu tài khoản mẫu demo các vai trò)
# ==============================================================================
# Mật khẩu khởi tạo mẫu cho các tài khoản seed:
#   - admin1@gmail.com           (ADMIN)             -> Quản trị viên hệ thống
#   - business1@gmail.com        (BUSINESS_MANAGER)  -> Giám đốc vận hành & doanh thu
#   - manager1@gmail.com         (FACILITY_MANAGER)  -> Quản lý cơ sở kho (HCM-D1)
#   - staff1@gmail.com           (STAFF)             -> Nhân viên check-in & bàn giao kho
#   - customer1@gmail.com        (CUSTOMER)          -> Khách hàng thuê kho
SEED_ADMIN_PASSWORD=Admin@123
SEED_FACILITY_MANAGER_PASSWORD=Manager@123
SEED_BUSINESS_MANAGER_PASSWORD=Manager@123
SEED_STAFF_PASSWORD=Staff@123
SEED_CUSTOMER_PASSWORD=Customer@123


# ==============================================================================
# 10. VNPAY SANDBOX (Cổng thanh toán điện tử thử nghiệm)
# ==============================================================================
# Đăng ký tài khoản Sandbox tại cổng Merchant thử nghiệm: https://sandbox.vnpayment.vn/
# Hoặc sử dụng cặp mã TMN_CODE và HASH_SECRET thử nghiệm được cấp mặc định:
VNPAY_TMN_CODE=U7PZC0X5
VNPAY_HASH_SECRET=VLRAQQHFJORSSMHIDNAJMKPGGHTSRQRE
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return

# Tham số mặc định theo chuẩn VNPay API 2.1.0:
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other

# ------------------------------------------------------------------------------
# THÔNG TIN THẺ TEST THỬ NGHIỆM TRÊN CỔNG VNPAY SANDBOX (Ngân hàng Quốc Dân - NCB):
#   - Ngân hàng: NCB
#   - Số thẻ: 9704198526191432198
#   - Tên chủ thẻ: NGUYEN VAN A
#   - Ngày phát hành: 07/15
#   - Mã OTP SMS xác thực: 123456
# ------------------------------------------------------------------------------


# ==============================================================================
# 11. DOCUSEAL (Hợp đồng điện tử & Ký số trực tuyến)
# ==============================================================================
# Hệ thống hỗ trợ 3 chế độ vận hành linh hoạt cho ký hợp đồng:
#
# CHẾ ĐỘ 1: KÝ QUA MÃ OTP NỘI BỘ (MẶC ĐỊNH - KHÔNG CẦN CẤU HÌNH NGOÀI)
#   - Đặt DOCUSEAL_MOCK_ENABLED=true
#   - Khách hàng ký số hợp đồng qua mã xác thực OTP 6 số gửi thẳng về email.
#
# CHẾ ĐỘ 2: CHẠY CLOUD DOCUSEAL
#   - Đăng ký tài khoản miễn phí tại: https://www.docuseal.com
#   - Lấy API Key tại: Settings -> API & Webhooks -> Generate API Key
#   - Cấu hình: DOCUSEAL_MOCK_ENABLED=false
#
# CHẾ ĐỘ 3: SELF-HOST DOCUSEAL QUA DOCKER (On-Premise)
#   - Lệnh chạy Docker: docker run -p 3000:3000 -v docuseal_data:/data docuseal/docuseal
#   - Cấu hình: DOCUSEAL_API_URL=http://localhost:3000/api
# ------------------------------------------------------------------------------
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=1
DOCUSEAL_RENEWAL_TEMPLATE_ID=1
DOCUSEAL_WEBHOOK_TOKEN=boxora_docuseal_webhook_secret
DOCUSEAL_MOCK_ENABLED=true


# ==============================================================================
# 12. GOOGLE OAUTH 2.0 / SOCIAL LOGIN (Đăng nhập mạng xã hội)
# ==============================================================================
# Dùng để xác thực và liên kết tài khoản khách hàng thông qua Google Identity Services:
#   - Đăng ký và lấy Client ID tại Google Cloud Console: https://console.cloud.google.com/
#   - Authorized JavaScript origins: http://localhost:5173 và http://localhost:8080
GOOGLE_CLIENT_ID=564968487479-aooibm2esqg9bic2iuu1a729ci4qfo3q.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=


# ==============================================================================
# 13. REDIS (Distributed Lock & Caching)
# ==============================================================================
# Dùng để phân tán soft-lock khi khách hàng giữ chỗ kho và tối ưu tốc độ truy vấn.
#   - Cách chạy Redis nhanh bằng Docker: docker run -d --name boxora-redis -p 6379:6379 redis:alpine
#   - Nếu máy dev không chạy Redis, đặt REDIS_ENABLED=false:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false


# ==============================================================================
# 14. SCHEDULING & CRON JOBS (Tác vụ nền định kỳ tự động)
# ==============================================================================
# Bật/tắt hệ thống chạy các tác vụ nền:
SCHEDULING_ENABLED=true

# Biểu thức Cron quét hợp đồng quá hạn & tính phí trễ hạn (Mặc định: 01:00 AM mỗi đêm):
SCHEDULING_OVERDUE_CRON=0 0 1 * * ?

# Biểu thức Cron tự động quét và hủy các đơn giữ chỗ chưa thanh toán:
AUTO_CANCEL_CRON=0 */15 * * * ?

# Thời gian tối đa (phút) giữ đơn trạng thái PENDING chờ cọc trước khi hủy tự động (1440 phút = 24h):
PENDING_TIMEOUT_MINUTES=1440
BOOKING_PAYMENT_TIMEOUT_MINUTES=1440


# ==============================================================================
# 15. BOOKING RULES & SOFT-LOCK LOGIC
# ==============================================================================
# Số giờ giữ chỗ buồng kho tạm thời (soft-lock) trong quá trình điền đơn:
BOOKING_SOFT_LOCK_HOURS=1

# Số ngày tối đa khách hàng được phép đặt trước ngày bắt đầu thuê kho:
BOOKING_MAX_ADVANCE_DAYS=30


# ==============================================================================
# 16. FILE UPLOAD & LOCAL STORAGE FALLBACK
# ==============================================================================
# Thư mục lưu trữ tệp tin cục bộ khi không kết nối Cloudflare R2:
UPLOAD_DIR=uploads


# ==============================================================================
# 17. CLOUDFLARE R2 OBJECT STORAGE (Lưu trữ ảnh buồng kho & biên bản bàn giao)
# ==============================================================================
# Dịch vụ Cloud Object Storage tương thích chuẩn AWS S3 của Cloudflare:
R2_ACCOUNT_ID=0e057a93c13437ab7a9f464e23cd9b48
R2_BUCKET_NAME=boxora-storage-units
R2_PUBLIC_URL=https://pub-e15c7d96a163417fa2a23d5b849ee035.r2.dev
R2_ENDPOINT=https://0e057a93c13437ab7a9f464e23cd9b48.r2.cloudflarestorage.com


# ==============================================================================
# 18. GOOGLE GEMINI AI CHATBOT (Trợ lý thông minh Boxora AI 24/7)
# ==============================================================================
# Danh sách API keys của Google Gemini AI (Lấy tại Google AI Studio: https://aistudio.google.com/)
# Hỗ trợ phân tách nhiều key bằng dấu phẩy để hệ thống tự động xoay vòng (Key Rotation) tránh lỗi 429:
# Mẫu: GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...,AIzaSyC...
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
