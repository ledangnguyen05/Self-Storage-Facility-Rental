# ==========================================
# Database
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/boxora_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ==========================================
# JPA / Hibernate
# ==========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ==========================================
# Mail
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# ==========================================
# JWT
# ==========================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ==========================================
# Async Thread Pool
# ==========================================
ASYNC_CORE_SIZE=5
ASYNC_MAX_SIZE=10

# ==========================================
# Server & Frontend
# ==========================================
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:5173

# ==========================================
# Swagger
# ==========================================
SWAGGER_API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html

# ==========================================
# Logging
# ==========================================
LOGGING_APP_LEVEL=DEBUG
LOGGING_SECURITY_LEVEL=INFO

# ==========================================
# Seed Users Default Passwords
# ==========================================
SEED_ADMIN_PASSWORD=admin
SEED_FACILITY_MANAGER_PASSWORD=facility
SEED_BUSINESS_MANAGER_PASSWORD=business
SEED_STAFF_PASSWORD=staff
SEED_CUSTOMER_PASSWORD=customer
