# ==============================================================================
# BOXORA REPOSITORY ROOT - CI/CD & PROJECT MANAGEMENT CONFIGURATION (.env.example)
# ==============================================================================
# LƯU Ý ĐIỀU HƯỚNG CẤU HÌNH MÔI TRƯỜNG DỰ ÁN:
#   - Cấu hình Backend (Spring Boot, DB, JWT, VNPay, DocuSeal, Mail, Redis):
#     Xem file: BE/boxora/.env.example
#   - Cấu hình Frontend (React, Vite, API Base URL, Google OAuth):
#     Xem file: FE/boxora-web/.env.example
#   - File này dùng cho script tự động hóa đồng bộ GitHub Project & SonarQube scan.
# ==============================================================================

# GitHub Project connection
GITHUB_PROJECT_URL=https://github.com/users/funef21205/projects/2
GITHUB_OWNER=funef21205
GITHUB_DEFAULT_REPOSITORY=BOXORA-BE
GITHUB_BE_REPOSITORY=BOXORA-BE
GITHUB_FE_REPOSITORY=BOXORA-FE
GITHUB_PROJECT_NUMBER=2
GITHUB_API_URL=https://api.github.com

# GitHub Token & dry-run toggle
GITHUB_TOKEN=REPLACE_WITH_LOCAL_TOKEN
GITHUB_PROJECT_DRY_RUN=true
GITHUB_DEFAULT_BRANCH=main

# SonarQube Scanner token
SONAR_TOKEN=REPLACE_WITH_SONAR_TOKEN
