# ==============================================================================
# BOXORA SYSTEM - PROJECT ROOT ENVIRONMENT OVERVIEW (.env.example)
# Hệ thống quản lý và cho thuê chuỗi kho tự quản thông minh Boxora (Self-Storage)
# ==============================================================================
# ĐIỀU HƯỚNG CẤU HÌNH MÔI TRƯỜNG DỰ ÁN:
#
# 1. Cấu hình Backend (Spring Boot, PostgreSQL, JWT, VNPay, Mail, Gemini AI, R2):
#    👉 Đường dẫn: BE/boxora/.env.example
#    👉 Lệnh tạo: cd BE/boxora && copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/macOS)
#
# 2. Cấu hình Frontend (React, Vite, API Base URL, Google OAuth):
#    👉 Đường dẫn: FE/boxora-web/.env.example
#    👉 Lệnh tạo: cd FE/boxora-web && copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/macOS)
#
# 3. CHÚ Ý BẢO MẬT:
#    - TUYỆT ĐỐI KHÔNG commit bất kỳ file .env hoặc thông tin bí mật nào lên Git.
#    - Toàn bộ file .env, private keys, database dumps đã được chặn nghiêm ngặt trong .gitignore.
# ==============================================================================

# ==========================================
# GITHUB CI/CD & PROJECT MANAGEMENT
# ==========================================
GITHUB_PROJECT_URL=https://github.com/users/funef21205/projects/2
GITHUB_OWNER=funef21205
GITHUB_DEFAULT_REPOSITORY=BOXORA-BE
GITHUB_BE_REPOSITORY=BOXORA-BE
GITHUB_FE_REPOSITORY=BOXORA-FE
GITHUB_PROJECT_NUMBER=2
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=REPLACE_WITH_LOCAL_TOKEN
GITHUB_PROJECT_DRY_RUN=true
GITHUB_DEFAULT_BRANCH=dev

# ==========================================
# SONARQUBE QUALITY GATE
# ==========================================
SONAR_TOKEN=REPLACE_WITH_SONAR_TOKEN
