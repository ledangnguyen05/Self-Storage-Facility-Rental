# ==========================================
# Database
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/boxora_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password


# ==========================================
# JPA / Hibernate
# ==========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true


# ==========================================
# Mail
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true


# ==========================================
# JWT
# ==========================================
JWT_SECRET=replace_with_a_secure_random_secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ==========================================
# Async Thread Pool
# ==========================================
ASYNC_CORE_SIZE=5
ASYNC_MAX_SIZE=10


# ==========================================
# Server
# ==========================================
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:5173

# ==========================================
# Swagger
# ==========================================
SWAGGER_API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html


# ==========================================
# Logging
# ==========================================
LOGGING_APP_LEVEL=DEBUG
LOGGING_SECURITY_LEVEL=INFO


# ==========================================
# Seed Users
# ==========================================
SEED_ADMIN_PASSWORD=replace_with_admin_password
SEED_FACILITY_MANAGER_PASSWORD=replace_with_facility_manager_password
SEED_BUSINESS_MANAGER_PASSWORD=replace_with_business_manager_password
SEED_STAFF_PASSWORD=replace_with_staff_password
SEED_CUSTOMER_PASSWORD=replace_with_customer_password

# ==========================================
# VNPay Sandbox
# ==========================================
VNPAY_TMN_CODE=your_vnpay_terminal_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret