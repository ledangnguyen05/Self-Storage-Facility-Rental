# ==============================================================================
# BOXORA FRONTEND - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# Hệ thống giao diện người dùng Boxora Web (React + TypeScript + TailwindCSS + Vite)
# ==============================================================================
# HƯỚNG DẪN BẮT ĐẦU NHANH (QUICK START):
# 1. Tạo file .env từ template này trong thư mục FE/boxora-web/:
#      - Windows (PowerShell): Copy-Item .env.example .env
#      - Windows (CMD):        copy .env.example .env
#      - Linux / macOS:        cp .env.example .env
# 2. File .env và các file chứa secret đã được cấu hình trong .gitignore,
#    TUYỆT ĐỐI KHÔNG commit file .env chứa thông tin môi trường thật lên Git.
# 3. Cài đặt thư viện: npm install
# 4. Khởi chạy môi trường phát triển: npm run dev
#    Giao diện web mặc định: http://localhost:5173
# ==============================================================================

# ==========================================
# 1. BACKEND API BASE URL
# ==========================================
# Địa chỉ HTTP của máy chủ Backend Boxora (Spring Boot):
#   - Mặc định khi chạy local: http://localhost:8080
#   - Nếu deploy production: https://api.boxora.vn hoặc URL server thực tế
#   - Nếu để trống (""), Vite sẽ sử dụng reverse proxy theo cấu hình trong vite.config.ts
VITE_API_BASE_URL=http://localhost:8080

# ==========================================
# 2. GOOGLE OAUTH 2.0 / ONE-TAP LOGIN
# ==========================================
# Google Client ID (dành cho Google Identity Services SDK):
#   - Cần cấu hình trùng khớp với GOOGLE_CLIENT_ID bên Backend Spring Boot.
#   - Đăng ký và lấy Client ID tại Google Cloud Console: https://console.cloud.google.com/
#   - BẮT BUỘC thêm "http://localhost:5173" vào mục Authorized JavaScript Origins.
#   - Nếu để trống, hệ thống sử dụng Client ID thử nghiệm tích hợp sẵn.
VITE_GOOGLE_CLIENT_ID=542516645937-hkrv64ot9mpgbge0ioifij46k56cstvc.apps.googleusercontent.com
