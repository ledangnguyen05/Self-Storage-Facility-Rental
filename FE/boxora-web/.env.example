# ==============================================================================
# BOXORA FRONTEND - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# Hệ thống giao diện người dùng Boxora Web (React + TypeScript + Vite)
# ==============================================================================
# HƯỚNG DẪN BẮT ĐẦU:
# 1. Sao chép file này và đổi tên thành .env hoặc .env.local trong thư mục FE/boxora-web/:
#      - Windows (PowerShell): Copy-Item .env.example .env
#      - Windows (CMD):        copy .env.example .env
#      - Linux / macOS:        cp .env.example .env
# 2. File .env và .env.local đã được liệt kê trong .gitignore để bảo vệ thông tin môi trường.
# 3. Sau khi tạo .env, khởi động frontend bằng lệnh: npm run dev
# ==============================================================================

# ==========================================
# 1. BACKEND API URL
# ==========================================
# Địa chỉ URL của Backend Spring Boot Server:
# - Để trống ("") nếu sử dụng cơ chế reverse proxy của Vite (cấu hình trong vite.config.ts)
# - Hoặc điền địa chỉ Backend khi gọi trực tiếp (mặc định: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# ==========================================
# 2. GOOGLE OAUTH 2.0 / SIGN-IN (CLIENT ID)
# ==========================================
# Client ID từ Google Cloud Console (dành cho Google Identity Services / One-Tap Login):
# Phải trùng khớp với Client ID đã cấu hình ở Backend (GOOGLE_CLIENT_ID)
# Lưu ý: Cần thêm http://localhost:5173 vào Authorized JavaScript Origins trên Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
